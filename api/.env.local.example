###> symfony/framework-bundle ###
###> Generate a random secret at https://randomkeygen.com/ ###
APP_SECRET=generate_your_secret_here
DATABASE_URL="mysql://your_db_user:your_db_password@mysql_db:3306/through_line?serverVersion=8.0"
###< symfony/framework-bundle ###

###> lexik/jwt-authentication-bundle ###
# Paths can stay as below; set JWT_PASSPHRASE in api/.env.local (do NOT commit).
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_random_passphrase
###< lexik/jwt-authentication-bundle ###

###> Google OAuth ###
# Get these from Google Cloud Console (https://console.cloud.google.com)
# See README for setup instructions
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
###< Google OAuth ###
